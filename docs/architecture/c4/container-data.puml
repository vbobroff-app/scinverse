@startuml Scinverse_Container_DataContext
' C4 Level 2 — Container. Data Context + соседи (Presentation shells, NC, IAM). To-be.
' C4 stdlib (нужен PlantUML ≥ 1.2023; jar: tools/plantuml — см. arch.md §5).
!include <C4/C4_Container>

LAYOUT_LEFT_RIGHT()
skinparam nodesep 40
skinparam ranksep 90
skinparam wrapWidth 210

title Container Diagram — Data Context + NC + Fronts (to-be)

' --- Внешние ---
System_Ext(broker,   "Брокер", "TRANSAQ / QUIK")
System_Ext(exchange, "Биржа",  "Plaza2 (VPN) / MOEX")
System_Ext(iam,      "Identity & Access", "Keycloak (OIDC / JWT)")
System_Ext(rnd,      "R&D", "Research / Analytics (Python)")
System_Ext(consumer, "Внешние потребители", "Подписчики Scinverse API")

Container_Ext(gateway, "API Gateway", "YARP / Nginx", "Кромка: маршрутизация + проверка JWT (JWKS Keycloak)")

' --- Presentation shells (отдельные деплои / репы в перспективе) ---
Container(productUi, "Product Front", "React · BFE · self DB", "Dashboard, webGL-графики, будущие сделки. Читает ODS. Shell подключает NC как MFE remote.")
Container(adminUi,   "OHS Admin Front", "React", "Ops write-path: запись, коннекторы, покрытие. Отдельный shell; NC — тот же MFE remote.")

' --- NC: отдельный failure domain ---
Container(nc, "Notification Center", "сервис NC", "Единая лента уведомлений и инцидентов. Отдельный хост/деплой. Remote Module Federation для shell'ов.")

System_Boundary(dataCtx, "Data Context") {

    Container(ohs, "OHS — Online History Server", "C# / .NET 8", "WRITE-PATH + control-plane API. Коннекторы, ACL, батч-запись, сессии/гэпы. Публикует live в ODS и события в NC. API только с JWT Keycloak.")

    ContainerDb(dbPrimary, "TimescaleDB — PRIMARY", "PostgreSQL 16 + TimescaleDB", "Hypertables, continuous aggregates, compression, retention.")

    ContainerDb(dbReplica, "TimescaleDB — Replica", "PostgreSQL 16 + TimescaleDB", "Read-only: история, агрегаты, реконструкция стакана.")

    Container(ods, "ODS — Online Data Server", "C# / .NET 8 · ASP.NET Core", "READ-PATH для Product Front: серии, футпринты, стакан, live WS. JWT Keycloak.")
}

' --- Ingestion ---
Rel(broker,   ohs, "Маркет-дата", "коннектор")
Rel(exchange, ohs, "Маркет-дата", "Plaza2 (VPN)")
Rel(ohs, dbPrimary, "Батч-запись", "Npgsql COPY")
Rel(dbPrimary, dbReplica, "Репликация", "WAL streaming")
Rel(ohs, ods, "Live нормализованные события", "gRPC stream")
Rel(ods, dbReplica, "История / агрегаты", "SQL read-only")

' --- NC ---
Rel(ohs, nc, "События связи, записи, простой, ошибки", "HTTPS / ingest")
Rel(productUi, nc, "Лента уведомлений", "MFE + HTTPS/WS")
Rel(adminUi,   nc, "Лента уведомлений", "MFE + HTTPS/WS")

' --- Fronts → API (через gateway) ---
Rel(productUi, gateway, "Данные / live", "HTTPS / WS")
Rel(adminUi,   gateway, "Control-plane OHS", "HTTPS / WS")
Rel(consumer,  gateway, "Scinverse API", "HTTPS / WS")
Rel(gateway, ods, "Read API + live", "HTTPS / WS")
Rel(gateway, ohs, "Control-plane", "HTTPS / WS")
Rel(gateway, nc,  "NC API (если с кромки)", "HTTPS / WS")
Rel(gateway, iam, "Валидация JWT", "JWKS / OIDC")

' --- Прямой OIDC login shell'ов ---
Rel(productUi, iam, "OIDC login", "OIDC")
Rel(adminUi,   iam, "OIDC login", "OIDC")
Rel(nc,        iam, "Проверка JWT", "JWKS")
Rel(ohs,       iam, "Проверка JWT (control API)", "JWKS")
Rel(ods,       iam, "Проверка JWT", "JWKS")

Rel(rnd, dbReplica, "Чтение истории", "SQL read-only")

SHOW_LEGEND()
@enduml
